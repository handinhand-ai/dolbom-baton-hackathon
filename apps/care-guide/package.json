{
  "name": "dolbom-baton",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "돌봄바통 — AI 돌봄 인수인계 서비스 연습용 MVP (Next.js + TypeScript, 합성 데이터 전용)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset-local": "tsx --env-file-if-exists=.env.local scripts/reset-local.ts",
    "db:reembed": "tsx --env-file-if-exists=.env.local scripts/reembed.ts",
    "test": "tsx --test \"specs/**/*.spec.ts\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-pgvector": "0.0.15",
    "next": "16.4.5",
    "openai": "7.53.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
