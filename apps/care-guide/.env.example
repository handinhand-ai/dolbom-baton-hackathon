# 돌봄바통 MVP 환경변수 예시.
# 로컬: 이 파일을 .env.local 로 복사해 값을 채운다. Vercel: 프로젝트 Settings → Environment Variables 에 같은 이름으로 넣는다.
# 값이 비어 있으면 해당 기능은 "시연 모드"로 동작하고 화면 위쪽 노란 띠에 표시된다.
# 실제 키는 절대 커밋하지 않는다 (.env.local 은 .gitignore 대상). 모든 값은 서버에서만 쓰며 브라우저로 보내지 않는다.

# ---- DB: Supabase Postgres (pgvector) ----
# 비우면: 로컬은 PGlite(.local-db/), Vercel 은 메모리 PGlite(인스턴스가 바뀌면 초기화되는 시연용)
# Vercel(서버리스): Supabase 대시보드 > Connect > Transaction pooler (포트 6543) 문자열 권장
# 마이그레이션 실행(npm run db:migrate): Session pooler (포트 5432) 문자열 권장
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# 로컬 Supabase(supabase start)처럼 SSL이 없는 경우 false
DATABASE_SSL=true
# 로컬 PGlite 저장 위치 (DATABASE_URL 이 없을 때만 사용)
LOCAL_DB_DIR=

# ---- AI: OpenAI API (분석·답변·기록 정리, 임베딩, 받아쓰기) ----
# 비우면 규칙 기반 데모 분석 + 문자 해시 벡터 + 브라우저 음성 인식으로 동작한다.
OPENAI_API_KEY=
# openai | local (기본: 키가 있으면 openai)
AI_PROVIDER=
# 분석·답변 모델 (Responses API + Structured Outputs 지원 모델)
OPENAI_MODEL=gpt-5.4-mini
# 받아쓰기(STT) 모델. 음성은 저장하지 않고 메모리에서만 처리한다.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TIMEOUT_MS=45000

# ---- 임베딩 (vector(1024) 고정) ----
# openai | local-hash (기본: 키가 있으면 openai)
EMBEDDING_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- 검색 튜닝 (기획상 미정 값 → MVP 기본값) ----
SEARCH_LIMIT=8
SEARCH_RRF_K=60
# 비우면 openai 0.3 / local-hash 0.45
SEARCH_MIN_VECTOR_SCORE=

# ---- 세션 (기획상 미정 값 → MVP 기본값) ----
SESSION_IDLE_MINUTES=30

# ---- 데모 접근 (실제 인증 없음) ----
DEMO_STAFF_ID=staff_demo_01
# 보호자 승인 데모 화면/API. 인증이 없으므로 외부 공개 배포에서는 false 로 끈다.
DEMO_GUARDIAN_SCREEN=true
